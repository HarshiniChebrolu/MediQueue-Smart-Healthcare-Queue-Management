{
  "name": "mediqueue-root",
  "version": "1.0.0",
  "private": true,
  "description": "MediQueue Hospital Queue Management System",
  "scripts": {
    "start": "node server/src/server.js",
    "seed": "node server/src/seed/seed.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test": "npm --prefix server run test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
